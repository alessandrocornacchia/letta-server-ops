# letta-server-ops settings -> ~/.config/letta-server-ops/env (chmod 600)

# Slack "Letta Ops" bot (see slack-manifest.json). Leave empty to only log locally.
SLACK_BOT_TOKEN=
# Your Slack member ID (profile -> ⋮ -> Copy member ID), e.g. U0123456789
SLACK_USER_ID=

# Local patches to skip, comma-separated patch ids (see patches/README.md)
LETTA_PATCHES_DISABLED=

# Filled in by install.sh
LETTA_UNIT=letta-server
LETTA_NODE_BIN=
