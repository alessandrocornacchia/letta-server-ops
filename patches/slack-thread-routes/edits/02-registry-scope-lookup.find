  getRouteForScope(channel, chatId, agentId, conversationId, accountId) {
    const normalizedAccountId = accountId?.trim();
    const matches3 = getRoutesForChannel(channel).filter((route2) => route2.chatId === chatId && route2.agentId === agentId && route2.conversationId === conversationId && route2.outboundEnabled !== false && (!normalizedAccountId || (route2.accountId ?? LEGACY_CHANNEL_ACCOUNT_ID) === normalizedAccountId) && route2.enabled);
    if (matches3.length !== 1) {
      return null;
    }
    return matches3[0] ?? null;
  }
