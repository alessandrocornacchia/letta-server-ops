function clearAllRoutes() {
  routesByKey.clear();
}
// letta-server-ops slack-thread-routes: per-route activity, topics and thread choice
function lettaOpsRouteActivityTime(route) {
  for (const value of [route.lastActivityAt, route.updatedAt, route.createdAt]) {
    const time = value ? Date.parse(value) : Number.NaN;
    if (!Number.isNaN(time))
      return time;
  }
  return 0;
}
function lettaOpsRoutePreview(text) {
  const flat = typeof text === "string" ? text.replace(/\s+/g, " ").trim() : "";
  if (!flat)
    return;
  return flat.length > 120 ? `${flat.slice(0, 119)}…` : flat;
}
function lettaOpsRouteActivityFields(route) {
  return {
    ...route.lastActivityAt ? { lastActivityAt: route.lastActivityAt } : {},
    ...route.topicPreview ? { topicPreview: route.topicPreview } : {},
    ...route.lastMessagePreview ? { lastMessagePreview: route.lastMessagePreview } : {}
  };
}
function lettaOpsRecordRouteActivity(channelId, route, at = new Date, text) {
  try {
    const key = routeKey(channelId, route.chatId, route.accountId, route.threadId);
    const current = routesByKey.get(key);
    if (!current)
      return;
    const preview = lettaOpsRoutePreview(text);
    routesByKey.set(key, {
      ...current,
      lastActivityAt: at.toISOString(),
      ...preview ? { topicPreview: current.topicPreview ?? preview, lastMessagePreview: preview } : {}
    });
    const persisted = globalThis.__lettaOpsRouteActivityPersistedAt ??= new Map;
    const last = persisted.get(key);
    if (last === undefined || at.getTime() - last >= 60000) {
      persisted.set(key, at.getTime());
      saveRoutes(channelId);
    }
  } catch {}
}
function lettaOpsSelectRouteForScope(candidates, threadId) {
  if (candidates.length === 0)
    return null;
  if (threadId !== undefined && threadId !== null) {
    const exact = candidates.filter((route) => (route.threadId ?? null) === threadId);
    if (exact.length === 1)
      return { kind: "route", route: exact[0], reason: "requested-thread", candidateCount: candidates.length };
  }
  if (candidates.length === 1)
    return { kind: "route", route: candidates[0], reason: "only-route", candidateCount: 1 };
  if (new Set(candidates.map((route) => route.accountId ?? null)).size > 1)
    return null;
  return {
    kind: "ambiguous",
    candidates: [...candidates].sort((a, b) => lettaOpsRouteActivityTime(b) - lettaOpsRouteActivityTime(a)),
    requestedThreadId: threadId ?? null
  };
}
function lettaOpsFormatAge(ms) {
  const minutes = Math.max(0, Math.round(ms / 60000));
  if (minutes < 60)
    return `${minutes} min ago`;
  const hours = Math.round(minutes / 60);
  if (hours < 48)
    return `${hours} h ago`;
  return `${Math.round(hours / 24)} days ago`;
}
function lettaOpsThreadChoiceError(selection, channel, chatId, now = Date.now()) {
  const intro = selection.requestedThreadId ? `Error: thread ${selection.requestedThreadId} is not linked to this conversation in ${channel} chat ${chatId}.` : `Error: this conversation is linked to ${selection.candidates.length} threads in ${channel} chat ${chatId}, and no thread was given.`;
  const lines = selection.candidates.map((route) => {
    const topic = route.topicPreview ? `"${route.topicPreview}"` : "(topic unknown)";
    const latest = route.lastMessagePreview && route.lastMessagePreview !== route.topicPreview ? `; latest: "${route.lastMessagePreview}"` : "";
    return `- threadId="${route.threadId}": ${topic} (active ${lettaOpsFormatAge(now - lettaOpsRouteActivityTime(route))}${latest})`;
  });
  return [
    intro,
    "Decide where this message belongs, then call MessageChannel again:",
    ...lines,
    `- A different topic: start a new thread with target="channel:${chatId}" instead of chat_id. Replies there come back to this conversation.`,
    "Continue a thread only when the message is about that thread's topic."
  ].join("\n");
}
function lettaOpsRouteThreadId(normalized, options, accountId) {
  if (normalized.threadId !== null && normalized.threadId !== undefined)
    return normalized.threadId;
  const threadIds = new Set;
  for (const source of options.channelTurnSources ?? []) {
    if (source.channel !== normalized.channel || source.chatId !== normalized.chatId || source.agentId !== options.scope.agentId || source.conversationId !== options.scope.conversationId || accountId && source.accountId !== accountId)
      continue;
    threadIds.add(source.threadId ?? null);
  }
  return threadIds.size === 1 ? [...threadIds][0] : null;
}
